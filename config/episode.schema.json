{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "english-ko-kho/episode.schema.json",
  "title": "English Ko Khó – dữ liệu một tập",
  "description": "Giao kèo giữa khâu soạn nội dung và khâu dựng video. Lời đọc (vo) viết tiếng Việt; đoạn cần giọng bản ngữ bọc trong [en:...].",
  "type": "object",
  "required": ["id", "episode", "format", "status", "title_vi", "hook", "words", "summary", "quiz", "publish"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "format": { "const": "root_family" } }, "required": ["format"] },
      "then": { "required": ["root"] },
      "else": { "required": ["topic"] }
    },
    {
      "if": { "properties": { "format": { "const": "surprising_origin" } }, "required": ["format"] },
      "then": { "properties": { "words": { "items": { "required": ["origin_vi"] } } } }
    },
    {
      "if": { "properties": { "format": { "const": "sino_vietnamese" } }, "required": ["format"] },
      "then": { "properties": { "words": { "items": { "required": ["han_viet"] } } } }
    },
    {
      "if": { "properties": { "format": { "const": "confusing_pair" } }, "required": ["format"] },
      "then": { "properties": { "summary": { "required": ["tip_vi"] } } }
    }
  ],
  "$defs": {
    "vo": {
      "type": "string",
      "minLength": 2,
      "description": "Lời đọc. Tiếng Việt đọc bằng giọng VI; đoạn [en:...] đọc bằng giọng EN. Tránh dấu gạch nối giữa chữ (La-tinh đọc thành 'la âm tinh')."
    },
    "part": {
      "type": "object",
      "required": ["text", "type"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "type": { "enum": ["prefix", "root", "suffix", "plain"] },
        "meaning_vi": { "type": "string" }
      }
    },
    "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[0-9]{3}-[a-z0-9-]+$", "description": "Trùng tên thư mục, ví dụ 001-spect" },
    "episode": { "type": "integer", "minimum": 1 },
    "format": {
      "enum": ["root_family", "confusing_pair", "surprising_origin", "guess_challenge", "sino_vietnamese"],
      "description": "Dạng tập, cấu hình ở config/formats.json. root_family cần `root`, các dạng khác cần `topic`. Mẫu cho từng dạng: episodes/000-demo*."
    },
    "status": {
      "enum": ["draft", "verified", "rendered", "published"],
      "description": "draft: Claude soạn; verified: người đã kiểm 2 nguồn mỗi từ; rendered: đã có mp4; published: đã đăng"
    },
    "title_vi": { "type": "string", "maxLength": 70 },
    "series_note_vi": { "type": "string", "description": "Ghi chú nối tập, ví dụ 'bạn đã gặp từ này ở tập 2'" },
    "hook": {
      "type": "object",
      "required": ["vo", "on_screen"],
      "additionalProperties": false,
      "properties": {
        "vo": { "$ref": "#/$defs/vo" },
        "on_screen": { "type": "string", "maxLength": 60 }
      }
    },
    "topic": {
      "type": "object",
      "required": ["title", "vo"],
      "additionalProperties": false,
      "description": "Cảnh giới thiệu chủ đề của các dạng không phải root_family (thay cho root)",
      "properties": {
        "title": { "type": "string", "maxLength": 28, "description": "Chữ to giữa màn hình và ảnh bìa, ví dụ 'Hy Lạp ↔ Hán Việt'" },
        "subtitle_vi": { "type": "string", "maxLength": 60 },
        "emoji": { "type": "string" },
        "vo": { "$ref": "#/$defs/vo" }
      }
    },
    "root": {
      "type": "object",
      "description": "Gốc từ của tập root_family",
      "required": ["text", "origin", "meaning_vi", "vo"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "description": "Gốc hiển thị, ví dụ SPECT" },
        "variants": { "type": "array", "items": { "type": "string" } },
        "origin": { "type": "string", "description": "Ví dụ: Latin specere" },
        "meaning_vi": { "type": "string" },
        "emoji": { "type": "string" },
        "vo": { "$ref": "#/$defs/vo" }
      }
    },
    "words": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["word", "parts", "ipa", "pos", "meaning_vi", "vo", "example_en", "sources", "verified"],
        "additionalProperties": false,
        "properties": {
          "word": { "type": "string" },
          "parts": { "$ref": "#/$defs/parts" },
          "ipa": { "type": "string", "pattern": "^/.+/$" },
          "pos": { "type": "string", "description": "n. / v. / adj. / adv. ..." },
          "meaning_vi": { "type": "string", "maxLength": 40 },
          "vo": { "$ref": "#/$defs/vo" },
          "example_en": { "type": "string" },
          "example_vi": { "type": "string" },
          "emoji": { "type": "string" },
          "mnemonic": { "type": "boolean", "description": "true nếu lời giải thích là mẹo nhớ, không phải từ nguyên chính xác" },
          "note_vi": { "type": "string", "description": "Lưu ý ngắn trên màn hình, ví dụ đổi trọng âm" },
          "origin_vi": { "type": "string", "maxLength": 40, "description": "surprising_origin: nguồn gốc ngắn trên màn hình, ví dụ 'Ý: quaranta = bốn mươi'" },
          "then_vi": { "type": "string", "maxLength": 30, "description": "surprising_origin: nghĩa ngày xưa (cảnh Xưa → Nay); nghĩa nay là meaning_vi" },
          "han_viet": { "type": "string", "maxLength": 24, "description": "sino_vietnamese: từ Hán Việt tương ứng, ví dụ 'thủy điện'. meaning_vi của từng mảnh là chữ Hán Việt của mảnh đó" },
          "from_vi": { "type": "string", "maxLength": 30, "description": "guess_challenge: đã học ở đâu, ví dụ 'tập 3 · -PORT-'" },
          "sources": { "type": "array", "items": { "type": "string" } },
          "verified": { "type": "boolean" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["vo"],
      "additionalProperties": false,
      "properties": {
        "vo": { "$ref": "#/$defs/vo" },
        "tip_vi": { "type": "string", "maxLength": 90, "description": "Mẹo ngắn dưới bảng tổng kết (bắt buộc với confusing_pair)" }
      }
    },
    "quiz": {
      "type": "object",
      "description": "Câu đố cuối: một từ mới (word + parts) hoặc câu điền từ (sentence_en + options)",
      "required": ["hint_vi", "vo", "answer_vi"],
      "anyOf": [{ "required": ["word", "parts"] }, { "required": ["sentence_en", "options"] }],
      "additionalProperties": false,
      "properties": {
        "word": { "type": "string" },
        "sentence_en": { "type": "string", "pattern": "___", "description": "Câu có chỗ trống ___, ví dụ cho confusing_pair" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string" } },
        "parts": { "$ref": "#/$defs/parts" },
        "ipa": { "type": "string" },
        "hint_vi": { "type": "string" },
        "vo": { "$ref": "#/$defs/vo" },
        "answer_vi": { "type": "string", "description": "Không hiện trong video; dùng cho bình luận ghim" }
      }
    },
    "disclaimer_vi": { "type": "string", "description": "Câu nói rõ đâu là mẹo nhớ (Content Plan mục 4)" },
    "lexicon": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Cách đọc riêng cho giọng VI, ví dụ {\"SPECT\": \"x pếch\"}"
    },
    "music": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "description": "Đường dẫn trong public/, ví dụ music/chill.mp3" },
        "source": { "type": "string", "description": "Nguồn + giấy phép" },
        "volume": { "type": "number" }
      }
    },
    "publish": {
      "type": "object",
      "required": ["youtube_title", "tiktok_caption", "hashtags", "pinned_comment"],
      "additionalProperties": false,
      "properties": {
        "youtube_title": { "type": "string", "maxLength": 90 },
        "youtube_description": { "type": "string" },
        "tiktok_caption": { "type": "string", "maxLength": 300 },
        "hashtags": { "type": "array", "items": { "type": "string", "pattern": "^#\\S+$" } },
        "pinned_comment": { "type": "string", "description": "Bình luận ghim dạng câu hỏi (KHÔNG chứa đáp án); đáp án lấy từ quiz.answer_vi, đăng sau 24h" },
        "cover_text": { "type": "string", "description": "Chữ trên ảnh bìa, mặc định = hook.on_screen" }
      }
    }
  }
}
